datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String       @unique
  password    String
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  user     User   @relation(fields: [userId], references: [id])
  resource String // e.g., "QUOTE", "PRODUCT"
  action   String // e.g., "READ", "WRITE", "DELETE"
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  company   String?
  phone     String?
  email     String?
  status    String   @default("NEW") // NEW, CONTACTED, QUALIFIED, LOST
  source    String?  @default("DIRECT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  clientName String
  documentId String?
  phone      String?
  email      String?
  items      Json     // Array of { description: string, quantity: number, price: number }
  totalValue Float
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AccountsReceivable {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientName  String
  description String?
  value       Float
  dueDate     DateTime
  status      String   @default("PENDING") // PAID, PENDING, REVERSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  documentId String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  unitPrice   Float
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
