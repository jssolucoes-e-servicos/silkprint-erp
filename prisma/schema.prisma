datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  empresa   String?
  telefone  String?
  email     String?
  status    String   @default("Novo")
  origem    String?  @default("Direto")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Orcamento {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  cliente    String
  documento  String?
  telefone   String?
  email      String?
  itens      Json     // Array of { descricao: string, qtd: number, preco: number }
  valorTotal Float
  status     String   @default("PENDENTE") // PENDENTE, APROVADO, REJEITADO, CANCELADO
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContasReceber {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  cliente        String
  descricao      String?
  valor          Float
  dataVencimento DateTime
  status         String   @default("PENDENTE") // PAGO, PENDENTE, REVERTIDO
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Cliente {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  documento String?
  telefone  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
